        "apiVersion": 1,
        "image": "preview.svg"
      },
      {
        "name": "Discord Wide",
        "source": "discord-wide.css",
        "apiVersion": 1,
        "image": "preview.svg"
      },
      {
        "name": "Discord Wide + Banners",
